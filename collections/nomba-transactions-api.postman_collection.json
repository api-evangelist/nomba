  "info": {
    "_postman_id": "6fc5acfd-e910-4dcf-94fb-6f9cad4207ca",
    "name": "Nomba Accounts Transactions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Nomba Accounts API enables developers to manage business accounts on the Nomba platform. It provides endpoints for retrieving account details, fetching the parent account balance, and listing terminals assigned to an account. This API serves as the foundation for account management operations within the Nomba ecosystem.\n\nContact Support:\n Name: Nomba Developer Support",
      "type": "text/plain"
    }
  }
