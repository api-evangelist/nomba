      "id": "5895c4e9-e1c1-45bb-ad05-153a8eb5bf7e",
      "name": "Authentication",
      "description": {
        "content": "Endpoints for obtaining, refreshing, and revoking OAuth2 access tokens used to authenticate requests to all Nomba APIs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f98c75a7-7dd6-4d98-bb2d-c6b71264898f",
          "name": "Obtain access token",
          "request": {
            "name": "Obtain access token",
            "description": {
              "content": "Obtains an OAuth2 bearer access token using client credentials. The returned token must be included in the Authorization header of all subsequent API requests. Supports both Client-Credentials and PKCE authentication flows.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "auth",
                "token",
                "issue"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "68ab337c-6a07-4520-9548-c5f4ba8c3834",
