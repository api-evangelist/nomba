  "info": {
    "_postman_id": "9dc84764-d090-4ff2-beef-eaf32ccca074",
    "name": "Nomba Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Nomba Authentication API provides OAuth2-based authentication for accessing all Nomba API endpoints. It supports two authentication methods: Client-Credentials for server-to-server integrations and PKCE (Proof Key for Code Exchange) for client-side applications. Developers obtain HTTP bearer tokens that are used to authorize subsequent API calls across the Nomba platform.\n\nContact Support:\n Name: Nomba Developer Support",
      "type": "text/plain"
    }
  }
