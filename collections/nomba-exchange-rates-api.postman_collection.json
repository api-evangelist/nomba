            "name": "Fetch live exchange rates",
            "description": {
              "content": "Retrieves the current live exchange rates for all supported payout corridors. Rates are indicative and may change. Use the rate lock endpoint to secure a rate before initiating a payout.",
              "type": "text/plain"
            },
