{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Bank",
  "title": "Bank",
  "type": "object",
  "properties": {
    "bankCode": {
      "type": "string",
      "description": "The unique code identifying the bank.",
      "example": "058"
    },
    "bankName": {
      "type": "string",
      "description": "The official name of the bank.",
      "example": "Guaranty Trust Bank"
    }
  }
}