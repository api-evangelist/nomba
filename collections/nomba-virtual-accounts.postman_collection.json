  "info": {
    "_postman_id": "0875e378-8449-41d9-a4be-614e944f8ef2",
    "name": "Nomba Virtual Accounts API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Nomba Virtual Accounts API allows developers to create and manage virtual bank accounts for receiving payments. There is no fixed limit to the number of virtual accounts that can be created for customers. The API supports creating, fetching, filtering, updating, and expiring virtual accounts, enabling businesses to collect payments via bank transfers with unique account numbers assigned to individual customers or transactions.\n\nContact Support:\n Name: Nomba Developer Support",
      "type": "text/plain"
    }
  }
