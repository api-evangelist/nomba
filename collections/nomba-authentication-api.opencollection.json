{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nomba Accounts Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nomba.com/v1/auth/token/issue",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Obtains an OAuth2 bearer access token using client credentials. The returned token must be included in the Authorization header of all subsequent API requests. Supports both Client-Credentials and PKCE authentication flows."
        },
        {
          "info": {
            "name": "Refresh an expired token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nomba.com/v1/auth/token/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Refreshes an expired access token using a previously issued refresh token. This allows applications to maintain long-lived sessions without requiring users to re-authenticate."
        },
        {
          "info": {
            "name": "Revoke an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nomba.com/v1/auth/token/revoke",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revokes a previously issued access token, invalidating it for future use. This is useful when a user logs out or when a token needs to be invalidated for security reasons."
        }
      ]
    }
  ],
  "bundled": true
}