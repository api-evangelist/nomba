  "info": {
    "_postman_id": "bfb01360-945e-471c-a08e-0c5c22b87456",
    "name": "Nomba Transactions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Nomba Transactions API allows developers to retrieve and manage transaction records. It provides endpoints for fetching account transaction history, filtering transactions by various criteria, and querying transaction details. This API is essential for building reporting dashboards, reconciliation tools, and transaction monitoring systems on top of the Nomba platform.\n\nContact Support:\n Name: Nomba Developer Support",
      "type": "text/plain"
    }
  }
