                  "disabled": false,
                  "key": "sourceCurrency",
                  "value": "<string>",
                  "description": "Filter rates by source currency."
                },
                {
                  "disabled": false,
                  "key": "destinationCurrency",
                  "value": "<string>",
                  "description": "Filter rates by destination currency."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The unique identifier of the parent business account.",
                "key": "accountId",
                "value": "<string>"
              },
